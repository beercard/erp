{
  "permissions": {
    "allow": [
      "mcp__plugin_context-mode_context-mode__ctx_search",
      "mcp__plugin_context-mode_context-mode__ctx_index",
      "mcp__plugin_context-mode_context-mode__ctx_stats",
      "mcp__plugin_context-mode_context-mode__ctx_doctor",
      "Bash(node .claude/skills/erp-contexto/scripts/*)",
      "Bash(node .claude/skills/erp-verificar/scripts/*)",
      "Bash(node .claude/skills/erp-mejoras/scripts/*)",
      "Bash(npm test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npx vitest run *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.production)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/contexto-inicio.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
