# Copiar a deploy/.env y completar. Nunca subir .env al repositorio.
# Generar claves: openssl rand -base64 48   /   openssl rand -hex 24

# Dominio público (apuntado al IP de la VPS) y su dirección completa.
DOMINIO=erp.tuempresa.com.ar
APP_URL=https://erp.tuempresa.com.ar
# Un subdominio por empresa (komsa.erp.tuempresa.com.ar). Necesita el DNS
# comodín *.erp.tuempresa.com.ar apuntando a la VPS. Vacío: todas las empresas
# entran por DOMINIO y eligen con cuál trabajar.
DOMINIO_EMPRESAS=

# Base de datos (la usa Postgres del compose).
POSTGRES_PASSWORD=

# Obligatorias de la aplicación.
ERP_CLAVE_MAESTRA=
CRON_SECRET=

# Correo saliente (Brevo, SES, Resend…).
SMTP_URL=
CORREO_REMITENTE="Vektra ERP <avisos@tuempresa.com.ar>"
# A quién avisar los errores del servidor (si no, a quienes administran la plataforma).
AVISOS_ADMIN=

# Opcionales: IA, WhatsApp, tiendas y pasarelas (ver .env.example en la raíz).
ANTHROPIC_API_KEY=
IA_MODELO=

# Cloudflare Turnstile (antibots en registro, contacto y recuperar la clave):
# dash.cloudflare.com → Turnstile → Add widget (dominio del sitio). Vacíos: sin desafío.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Vektra se factura sola: id de la empresa de Vektra dentro de este ERP (con su certificado de
# ARCA y un punto de venta electrónico). Cada pago de una suscripción genera su factura y se la
# manda al dueño de la empresa suscriptora. Vacío: no se factura. Se ve en la consola, ficha de
# cada empresa → "Facturas de Vektra".
VEKTRA_EMPRESA_ID=
