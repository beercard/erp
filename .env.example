# Variables del servidor de producción (ver docs/07-produccion.md).
# Copiar a .env y completar. Nunca subir el .env al repositorio.

# --- Obligatorias: sin ellas el servidor no arranca ---
# Postgres 16 o más nuevo. El usuario tiene que ser dueño de la base y poder crear roles.
DATABASE_URL=postgres://usuario:clave@servidor:5432/erp?sslmode=require
# Dirección pública, con https (va en los enlaces de los correos).
APP_URL=https://erp.tuempresa.com.ar
# Cifra los certificados de ARCA y las claves guardadas. Generar con: openssl rand -base64 48
# Si se pierde, hay que volver a cargar los certificados. No cambiarla una vez en uso.
ERP_CLAVE_MAESTRA=
# Protege la tarea programada (/api/cron/servicio). Generar con: openssl rand -hex 24
CRON_SECRET=

# --- Correo (recomendadas) ---
# smtp://usuario:clave@servidor:587 o smtps://usuario:clave@servidor:465
SMTP_URL=
CORREO_REMITENTE="ERP <avisos@tuempresa.com.ar>"

# --- Tiendas online (aplicación opcional; ver docs/08-tiendas-online.md) ---
# Aplicación de Mercado Libre de la plataforma.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Aplicación de Tienda Nube de la plataforma.
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=
# Email de soporte (lo pide Tienda Nube en cada llamada).
SOPORTE_EMAIL=soporte@vektra.com.ar

# --- Sitio comercial y cobro de suscripciones (ver docs/09-sitio-y-seo.md) ---
# Dirección pública del sitio (si falta, se usa APP_URL).
SITIO_URL=https://www.tudominio.com.ar
# Adónde llegan las consultas del sitio, y WhatsApp de ventas (opcionales).
CONTACTO_EMAIL=
CONTACTO_WHATSAPP=
# Mercado Pago de Vektra: débito automático de las suscripciones.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
